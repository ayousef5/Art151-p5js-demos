function setup() {
  // 200 wide, 400 tall
  createCanvas(200, 400);
}

function draw() {
  // Make the background black
  background(100);

  // Timer repeats every 540 frames
  let t = frameCount % 540;

  // Make the traffic light housing dark gray
  fill(40);

  // Draw the traffic light housing
  rect(50, 30, 100, 340, 20);

  // Make all three lights dark
  fill(50);
  circle(100, 100, 80);
  circle(100, 200, 80);
  circle(100, 300, 80);

  // Green for 3 seconds
  if (t < 180) {
    fill(0, 255, 0);
    circle(100, 300, 80);
  }

  // Yellow for 3 seconds
  else if (t < 360) {
    fill(255, 255, 0);
    circle(100, 200, 80);
  }

  // Red for 3 seconds
  else {
    fill(255, 0, 0);
    circle(100, 100, 80);
  }
}
